{
  "name": "pkg-ok",
  "version": "4.0.0",
  "description": "Checks package.json main and bin paths",
  "exports": "./dist/index.js",
  "bin": "./dist/bin.js",
  "files": [
    "CHANGELOG.md",
    "dist"
  ],
  "type": "module",
  "scripts": {
    "test": "npm run build && node --test \"src/**/*.test.ts\" && node ./dist/bin",
    "format": "prettier --write .",
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "lint": "prettier --check . && eslint . && tsc --noEmit",
    "prepublishOnly": "npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abraham/pkg-ok.git"
  },
  "keywords": [
    "package",
    "main",
    "bin",
    "field",
    "file",
    "path",
    "exist",
    "test",
    "crlf",
    "lf",
    "line ending"
  ],
  "author": "typicode <typicode@gmail.com>",
  "contributors": [
    "Abraham Williams <hi@abrah.am>"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/abraham/pkg-ok/issues"
  },
  "homepage": "https://github.com/abraham/pkg-ok#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.2.1",
    "globals": "^17.6.0",
    "prettier": "3.9.10",
    "type-fest": "^5.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "chalk": "^6.0.0",
    "meow": "^14.1.0",
    "normalize-newline": "^5.0.0"
  },
  "engines": {
    "node": "^22.17.0 || ^24.0.0 || ^26.0.0"
  }
}
